# ============================================================================
# CONFIGURACIÓN DE ENTORNO - FRONTEND (organirack-frontend)
# ============================================================================
# 
# Este archivo contiene las variables de entorno necesarias para el frontend
# de OrganiRack+ funcionando con el backend Headless en Laravel.
#
# INSTRUCCIONES:
# 1. Copia este archivo como .env.local
# 2. Actualiza los valores según tu entorno local/producción
# 3. Nunca commitees .env.local (está en .gitignore)
# ============================================================================

# URL del Backend API
# En desarrollo: http://localhost:8000/api
# En producción: https://api.organirackplus.com/api (o tu dominio)
#PONER EL URL QUE TE DE EL NGROK AL HACER EL COMANDO DE NGROK HTTP 8000 (EXPONER TU API)
VITE_API_BASE_URL=https://procellous-luanna-automorphically.ngrok-free.dev

# Nombre de la aplicación
# Se usa para títulos, mensajes, etc.
VITE_APP_NAME=OrganiRack+

# Modo debug (true/false)
# Muestra logs adicionales en consola cuando es true
VITE_DEBUG=true

# ============================================================================
# VARIABLES OPCIONALES (Usa solo si implementas integraciones adicionales)
# ============================================================================

# Para Google Maps (si lo usas en dashboard)
# VITE_GOOGLE_MAPS_API_KEY=tu_api_key_aqui

# Para Analytics
# VITE_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Para Sentry (error tracking)
# VITE_SENTRY_DSN=https://xxxxx@sentry.io/xxxxx