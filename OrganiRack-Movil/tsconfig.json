{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./*"],
      "@components/*": ["./components/*"],
      "@constants/*": ["./constants/*"],
      "@utils/*": ["./utils/*"],
      "@images/*": ["./assets/images/*"],
      "@API/*": ["./API/*"],
      "@context/*": ["./context/*"],
      "@models/*": ["./types/*"],
      "@hooks/*": ["./hooks/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
